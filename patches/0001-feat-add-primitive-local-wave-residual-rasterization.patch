+			if (wave_params != nullptr) for (int q = 0; q < 7; q++) collected_wave[q * BLOCK_SIZE + block.thread_rank()] = wave_params[7 * coll_id + q];
 		}
 		block.sync();
 
@@ -414,8 +417,17 @@ renderCUDA(
 #endif
 
 			// Eq. (3) from 3D Gaussian splatting paper.
-			for (int ch = 0; ch < CHANNELS; ch++)
-				C[ch] += features[collected_id[j] * CHANNELS + ch] * w;
+			float wave_value = 0.0f;
+			if (wave_params != nullptr) {
+				float phase = collected_wave[3 * BLOCK_SIZE + j] * s.x + collected_wave[4 * BLOCK_SIZE + j] * s.y + collected_wave[5 * BLOCK_SIZE + j];
+                float gate = collected_wave[6 * BLOCK_SIZE + j];
+				wave_value = gate * cosf(phase);
+			}
+			for (int ch = 0; ch < CHANNELS; ch++) {
+				float color = features[collected_id[j] * CHANNELS + ch];
+				if (wave_params != nullptr && ch < 3) color += collected_wave[ch * BLOCK_SIZE + j] * wave_value;
+				C[ch] += color * w;
+			}
 			T = test_T;
 
 			// Keep track of last range entry to update this
@@ -455,6 +467,7 @@ void FORWARD::render(
