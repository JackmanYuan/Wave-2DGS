diff --git a/cuda_rasterizer/backward.cu b/cuda_rasterizer/backward.cu
index 0a78cc2..4ed56ad 100644
--- a/cuda_rasterizer/backward.cu
+++ b/cuda_rasterizer/backward.cu
@@ -152,6 +152,7 @@ renderCUDA(
 	const float4* __restrict__ normal_opacity,
 	const float* __restrict__ transMats,
 	const float* __restrict__ colors,
+	const float* __restrict__ wave_params,
 	const float* __restrict__ depths,
 	const float* __restrict__ final_Ts,
 	const uint32_t* __restrict__ n_contrib,
@@ -161,7 +162,8 @@ renderCUDA(
 	float3* __restrict__ dL_dmean2D,
 	float* __restrict__ dL_dnormal3D,
 	float* __restrict__ dL_dopacity,
-	float* __restrict__ dL_dcolors)
+	float* __restrict__ dL_dcolors,
+	float* __restrict__ dL_dwave_params)
 {
 	// We rasterize again. Compute necessary block info.
 	auto block = cg::this_thread_block();
@@ -184,6 +186,7 @@ renderCUDA(
 	__shared__ float2 collected_xy[BLOCK_SIZE];
 	__shared__ float4 collected_normal_opacity[BLOCK_SIZE];
 	__shared__ float collected_colors[C * BLOCK_SIZE];
+	__shared__ float collected_wave[7 * BLOCK_SIZE];
 	__shared__ float3 collected_Tu[BLOCK_SIZE];
 	__shared__ float3 collected_Tv[BLOCK_SIZE];
 	__shared__ float3 collected_Tw[BLOCK_SIZE];
@@ -266,6 +269,7 @@ renderCUDA(
 			collected_Tw[block.thread_rank()] = {transMats[9 * coll_id+6], transMats[9 * coll_id+7], transMats[9 * coll_id+8]};
 			for (int i = 0; i < C; i++)
 				collected_colors[i * BLOCK_SIZE + block.thread_rank()] = colors[coll_id * C + i];
+			if (wave_params != nullptr) for (int q = 0; q < 7; q++) collected_wave[q * BLOCK_SIZE + block.thread_rank()] = wave_params[7 * coll_id + q];
 				// collected_depths[block.thread_rank()] = depths[coll_id];
 		}
 		block.sync();
@@ -324,9 +328,17 @@ renderCUDA(
 			// pair).
 			float dL_dalpha = 0.0f;
 			const int global_id = collected_id[j];
+			float wave_cos = 0.0f, wave_sin = 0.0f;
+			if (wave_params != nullptr) {
+				float wave_phase = collected_wave[3 * BLOCK_SIZE + j] * s.x + collected_wave[4 * BLOCK_SIZE + j] * s.y + collected_wave[5 * BLOCK_SIZE + j];
+                float wave_gate = collected_wave[6 * BLOCK_SIZE + j];
+				wave_cos = wave_gate * cosf(wave_phase); wave_sin = wave_gate * sinf(wave_phase);
+			}
+			float wave_phase_grad = 0.0f;
 			for (int ch = 0; ch < C; ch++)
 			{
-				const float c = collected_colors[ch * BLOCK_SIZE + j];
+				float c = collected_colors[ch * BLOCK_SIZE + j];
+				if (wave_params != nullptr && ch < 3) c += collected_wave[ch * BLOCK_SIZE + j] * wave_cos;
 				// Update last color (to be used in the next iteration)
 				accum_rec[ch] = last_alpha * last_color[ch] + (1.f - last_alpha) * accum_rec[ch];
 				last_color[ch] = c;
@@ -337,6 +349,18 @@ renderCUDA(
 				// Atomic, since this pixel is just one of potentially
 				// many that were affected by this Gaussian.
 				atomicAdd(&(dL_dcolors[global_id * C + ch]), dchannel_dcolor * dL_dchannel);
+				if (wave_params != nullptr && ch < 3) {
+					float g = dchannel_dcolor * dL_dchannel;
+					float amp = collected_wave[ch * BLOCK_SIZE + j];
+					atomicAdd(&dL_dwave_params[global_id * 7 + ch], g * wave_cos);
+					wave_phase_grad += g * amp * (-wave_sin);
+				}
+			}
+
+			if (wave_params != nullptr) {
+				atomicAdd(&dL_dwave_params[global_id * 7 + 3], wave_phase_grad * s.x);
+				atomicAdd(&dL_dwave_params[global_id * 7 + 4], wave_phase_grad * s.y);
+				atomicAdd(&dL_dwave_params[global_id * 7 + 5], wave_phase_grad);
 			}
 
 			float dL_dz = 0.0f;
@@ -399,8 +423,8 @@ renderCUDA(
 			if (rho3d <= rho2d) {
 				// Update gradients w.r.t. covariance of Gaussian 3x3 (T)
 				const float2 dL_ds = {
-					dL_dG * -G * s.x + dL_dz * Tw.x,
-					dL_dG * -G * s.y + dL_dz * Tw.y
+					dL_dG * -G * s.x + dL_dz * Tw.x + (wave_params != nullptr ? wave_phase_grad * collected_wave[3 * BLOCK_SIZE + j] : 0.0f),
+					dL_dG * -G * s.y + dL_dz * Tw.y + (wave_params != nullptr ? wave_phase_grad * collected_wave[4 * BLOCK_SIZE + j] : 0.0f)
 				};
 				const float3 dz_dTw = {s.x, s.y, 1.0};
 				const float dsx_pz = dL_ds.x / p.z;
@@ -697,8 +721,9 @@ void BACKWARD::render(
 	const float* bg_color,
 	const float2* means2D,
 	const float4* normal_opacity,
-	const float* colors,
 	const float* transMats,
+	const float* colors,
+	const float* wave_params,
 	const float* depths,
 	const float* final_Ts,
 	const uint32_t* n_contrib,
@@ -708,7 +733,8 @@ void BACKWARD::render(
 	float3* dL_dmean2D,
 	float* dL_dnormal3D,
 	float* dL_dopacity,
-	float* dL_dcolors)
+	float* dL_dcolors,
+	float* dL_dwave_params)
 {
 	renderCUDA<NUM_CHANNELS> << <grid, block >> >(
 		ranges,
@@ -720,6 +746,7 @@ void BACKWARD::render(
 		normal_opacity,
 		transMats,
 		colors,
+		wave_params,
 		depths,
 		final_Ts,
 		n_contrib,
@@ -729,6 +756,7 @@ void BACKWARD::render(
 		dL_dmean2D,
 		dL_dnormal3D,
 		dL_dopacity,
-		dL_dcolors
+		dL_dcolors,
+		dL_dwave_params
 		);
 }
