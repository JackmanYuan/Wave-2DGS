cff-version: 1.2.0
message: "If you use Wave-2DGS, please cite the accompanying paper and the original 2DGS work."
title: "Wave-2DGS: Sparse Local Wave Modulation for Appearance and Geometry Reconstruction"
type: software
authors:
  - family-names: Yuan
    given-names: Tzu-Chun
    affiliation: "National Center for High-performance Computing, National Institutes of Applied Research"
  - family-names: Tsai
    given-names: Tsung-Che
